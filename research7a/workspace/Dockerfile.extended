FROM python:3.12.7-slim
WORKDIR /app
RUN pip install --no-cache-dir networkx==3.7
COPY kit.py extended_policy.py ./
COPY research/terminal_model.py research/extended_candidates.py ./research/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 65534:65534
ENTRYPOINT ["python", "extended_policy.py"]
